# Copia este archivo a .env y completa los valores. .env está en .gitignore.

# --- Dynatrace (solo lectura) ---
# URL de la plataforma, sin barra final: https://<environment-id>.apps.dynatrace.com
DT_ENV_URL=
# Platform token con scopes de lectura de Grail (ver docs/despliegue.md)
DT_PLATFORM_TOKEN=
DT_LOOKBACK_DAYS=7
DT_QUERY_TIMEOUT_S=60
# Mapa nombre de cluster -> KUBERNETES_CLUSTER-... (copia config/clusters.example.yaml)
CLUSTERS_FILE=config/clusters.yaml
# Alternativa para contenedores (tiene prioridad sobre el archivo):
# CLUSTERS=eks-ejemplo-prod=KUBERNETES_CLUSTER-...,eks-ejemplo-qa=KUBERNETES_CLUSTER-...
CLUSTERS=

# --- ServiceNow ---
SNOW_INSTANCE_URL=https://<instancia>.service-now.com
SNOW_USERNAME=
SNOW_PASSWORD=
# sys_id o nombre del grupo de asignación de los incidentes
SNOW_ASSIGNMENT_GROUP=

# --- API ---
# Claves aceptadas en el header x-api-key, separadas por coma
API_KEYS=
# URL pública de la API (se usa en la especificación OpenAPI que consume Foundry)
PUBLIC_BASE_URL=https://<app>.azurecontainerapps.io
# Ambientes cuyos problems se tratan como prioridad alta (P2)
HIGH_PRIORITY_ENVIRONMENTS=PROD

# --- Microsoft Foundry (solo para foundry-setup) ---
PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
MODEL_DEPLOYMENT_NAME=
